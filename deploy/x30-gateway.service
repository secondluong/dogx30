[Unit]
Description=X30 遥控网关（运动控制 + 平板 WebSocket 服务）
Documentation=file:/opt/x30/docs/app-protocol.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 地址、端口、点云开关都在 conf/gateway.conf 里，这里刻意不重复它们：
# 两处各存一份的话，迟早出现「单元里写着 .103、实际跑的是 .200」，
# 而去读单元的人会信单元。控制台的「设置」面板改的就是那个文件。
ExecStart=/opt/x30/bin/x30_gateway \
    --config /opt/x30/conf/gateway.conf \
    --admin-token-file /opt/x30/conf/admin.token \
    --serve \
    --web /opt/x30/web \
    --media /opt/x30/media.json
WorkingDirectory=/opt/x30

# 网关掉线时机器狗会按 overtime.toml 自行降级停下，所以自动重启是安全的，
# 而且必须尽快 —— 每多停一秒操作员就多失控一秒。
#
# 控制台改配置也靠这一条：网关写完新配置就干净退出，由这里把它拉回来。
# 所以是 always 而不是 on-failure —— 改配置走的是正常退出（状态码 0）。
Restart=always
RestartSec=1

# 50 Hz 轴指令的抖动直接体现为机身晃动，给一档实时优先级。
# 不用 SCHED_FIFO：网关里有阻塞的网络 IO，真跑实时调度反而容易饿死其他进程。
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=x30-gateway

# 只需要网络，其余一律收紧。
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# conf/ 要可写，控制台的「设置」面板要往 gateway.conf 里写。
# 只给这个子目录而不是整个 /opt/x30 —— 后者等于让网关能改自己的二进制。
ReadWritePaths=/opt/x30/log /opt/x30/conf

[Install]
WantedBy=multi-user.target
