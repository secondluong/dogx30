<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/btn_radio_path"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="108dp"
        android:background="@drawable/btn_radio"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/radio_mesh"
        android:textColor="#E6EDF3"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D1117"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlay_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#8B98A9"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/overlay_host"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/hint_host"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773" />

        <EditText
            android:id="@+id/overlay_port"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_port"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773" />

        <Button
            android:id="@+id/overlay_retry"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
