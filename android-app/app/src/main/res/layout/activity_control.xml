<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D1117"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlay_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#8B98A9"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/overlay_host"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/hint_host"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773" />

        <EditText
            android:id="@+id/overlay_port"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_port"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773" />

        <Button
            android:id="@+id/overlay_retry"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
