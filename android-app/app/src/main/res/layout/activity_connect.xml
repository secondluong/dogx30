<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D1117"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#E6EDF3"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="28dp"
        android:text="@string/connect_subtitle"
        android:textColor="#8B98A9"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_host"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_host"
            android:inputType="text"
            android:digits="0123456789.abcdefghijklmnopqrstuvwxyz-"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/input_port"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:textColor="#E6EDF3"
            android:textColorHint="#5C6773"
            android:importantForAutofill="no" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="372dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/connect"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="372dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#F85149"
        android:textSize="13sp" />

    <TextView
        android:layout_width="372dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/connect_help"
        android:textColor="#5C6773"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.4" />

</LinearLayout>
