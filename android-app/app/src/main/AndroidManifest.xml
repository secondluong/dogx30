<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- 后续接入视频时云台/相机可能需要，先声明为可选，避免无摄像头设备装不上。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 安卓 11 起有包可见性限制：不声明这一条就看不见系统的语音引擎，
         TextToSpeech 初始化直接失败，而且没有任何报错 —— 表现是按键一句都不念。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".X30App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.X30">

        <!-- 遥控界面锁横屏。自转屏会在操作中途重建 Activity，
             WebSocket 断开、控制权丢失，机器狗会突然停下。
             不再先登录：WiFi 不通也进这里，摇杆走已对频的 2.4G。 -->
        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
